modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "photoclub-lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "review-club-lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "review-club-dutch-translation-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "photoclub-dutch-translation-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "photoclub-dutch-e2e-smoke"

[[workflows.workflow]]
name = "photoclub-lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/photoclub run lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "review-club-lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/review-club run lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "review-club-dutch-translation-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/review-club test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "photoclub-dutch-translation-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/photoclub test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "photoclub-dutch-e2e-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/photoclub run test:e2e"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 22135
externalPort = 3000

[[ports]]
localPort = 22381
externalPort = 3001

[objectStorage]
defaultBucketID = "replit-objstore-0a7fe58d-543c-4819-80df-52cb7b238c10"

[userenv]

[userenv.shared]
EMAIL_FROM = "PhotoMatrix <noreply@connectingthedots.fit>"
