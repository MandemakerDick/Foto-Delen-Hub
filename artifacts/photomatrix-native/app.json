{
  "expo": {
    "name": "PhotoMatrix",
    "slug": "photomatrix-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "photomatrix-native",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.photomatrix.club",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PhotoMatrix uses your photo library so you can share your photographs with your clubs.",
        "NSCameraUsageDescription": "PhotoMatrix uses your camera so you can capture photographs to share."
      }
    },
    "android": {
      "package": "com.photomatrix.club",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
